#include <iostream>   
#include <string>   
#include <cstdlib>
using namespace std;  
//Problem #19 - Print 3 Random Numbers From 1 To 10.
int RandomNumber(int From, int To)
{
	int RandNum = rand() % (To - From + 1) + From;
	return RandNum;
}
int main()
{	
	srand((unsigned)time(NULL));

	cout << RandomNumber(1, 10) << endl;
	cout << RandomNumber(1, 10) << endl;
	cout << RandomNumber(1, 10) << endl;
	
	return 0;  
}
