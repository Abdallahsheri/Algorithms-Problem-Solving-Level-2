#include <iostream>   
#include <string>
#include <cmath>
using namespace std;
//Problem#7 - Reverse Number. 
int ReadPositiveNumber(string Message)
{
	int Number;
	do
	{
		cout << Message << endl;
		cin >> Number;
	} while (Number <= 0);
	return Number;
}
int ReverseNumber(int Number)
{
	int Number2 = 0;
	int Remainder = 0;
	while(Number > 0)
	{
		Remainder = Number % 10;
		Number = Number / 10;
		Number2 = Number2 * 10 + Remainder;
	}
	return Number2;
}
int main()
{
	cout << "The Reverse Is = " << ReverseNumber(ReadPositiveNumber("Please enter a Positive Number : ")) << "\n";
		
    return 0;  
}
