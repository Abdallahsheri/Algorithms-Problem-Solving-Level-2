#include <iostream>   
#include <string>
#include <cmath>
using namespace std;
//Problem#1 - Print Multiplication Table. 

void PrintHeader()
{
	cout << "\n\n\t\t\t  MultiPlication Table From 1 To 10. \n\n";
	cout << "\t";

	for (int i = 1;i <= 10;i++)
	{
		cout << i << "\t";
	}
	cout << "\n___________________________________________________________________________________\n";

}
string CoulmunSepartor(int i)
{
	if (i < 10)
	{
		return "   |";
	}
	else
	{
		return "  |";
	}
}
void PrintMultiPlicationTable()
{
	PrintHeader();

	for (int i = 1; i <=10; i++)
	{
		cout << " " << i << CoulmunSepartor(i) << "\t";
		for (int j = 1; j <=10; j++)
		{
			cout << i * j << "\t";
		}
		cout << endl;
	}
}

int main()
{
	PrintMultiPlicationTable();
    return 0;  
}
