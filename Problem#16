#include <iostream>   
using namespace std;  
//Problem #16 - Print All Words From AAA To ZZZ.
void PrintAllWords()
{
	for (char i = 'A'; i <= 'Z'; i++)
	{
		for (char j = 'A'; j <= 'Z'; j++)
		{
			for (char k = 'A'; k <= 'Z'; k++)
			{
				cout << i << j << k << endl;
			}
		}
	}
}
int main()
{	
	PrintAllWords();
	return 0;  
}
